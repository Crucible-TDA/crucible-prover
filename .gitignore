# Rust build output
/target
**/*.rs.bk

# Noir build output (generated during compilation/proving)
**/target/
**/proofs/
**/Verifier.toml

# Witness input files are runtime material and may carry private values, so
# Prover.toml is ignored everywhere EXCEPT the explicitly synthetic test
# vectors committed under each circuit's testdata/ (public sample keys only).
**/Prover.toml
!circuits/**/testdata/Prover.toml

# Runtime-generated proof/artifact material that is produced by scripts and
# tests. Committed fixtures live under test-vectors/ and proofs/fixtures/.
/artifacts/generated/
/proofs/generated/

# Editor/OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Environment
.env
.env.*
